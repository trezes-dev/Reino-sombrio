.btn-acao:active{transform:scale(0.9)}
#btn-ataque{right:25px;bottom:70px;width:100px;height:100px;background:radial-gradient(circle at 35% 30%,#5a1010,#2a0808);border:4px solid #d4a04a;box-shadow:0 6px 0 #1a0404,0 8px 16px rgba(0,0,0,0.6),inset 0 4px 0 rgba(255,255,255,0.15)}
#btn-ferramenta{right:130px;bottom:130px;width:62px;height:62px;background:radial-gradient(circle at 35% 30%,#ffe055,#a07000);border-color:#ffee88;font-size:24px}
#btn-acao{right:25px;bottom:190px;width:64px;height:64px;background:radial-gradient(circle at 35% 30%,#5a3010,#2a1808);border:3px solid #d4a04a;box-shadow:0 4px 0 #1a0a04,0 6px 12px rgba(0,0,0,0.5),inset 0 3px 0 rgba(255,255,255,0.15);font-size:24px;display:none;animation:pulsar 1.2s infinite}
@keyframes pulsar{0%,100%{box-shadow:0 4px 0 #1a0a04,0 6px 12px rgba(0,0,0,0.5),inset 0 3px 0 rgba(255,255,255,0.15),0 0 0 0 rgba(212,160,74,0.7)}50%{box-shadow:0 4px 0 #1a0a04,0 6px 12px rgba(0,0,0,0.5),inset 0 3px 0 rgba(255,255,255,0.15),0 0 0 12px rgba(212,160,74,0)}}
