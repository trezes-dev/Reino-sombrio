// ============ RENDER ============


async function pegarDrop(dropId) {
    try {
        const res = await fetch('/api/pegar_drop/' + dropId, {method: 'POST'});
        const data = await res.json();
        if (!data.ok) return;
        // Animação: item voa até a hotbar
        const dropEl = document.querySelector('.drop-chao[data-drop-id="' + dropId + '"]');
        if (dropEl) {
            const rect = dropEl.getBoundingClientRect();
            const fly = document.createElement('div');
            fly.className = 'drop-fly';
            fly.style.backgroundImage = dropEl.style.backgroundImage;
            fly.style.left = rect.left + 'px';
            fly.style.top = rect.top + 'px';
            document.body.appendChild(fly);
            // Move para o inventário (canto superior direito)
            setTimeout(() => {
                fly.style.left = (window.innerWidth - 100) + 'px';
                fly.style.top = '100px';
                fly.style.width = '20px';
                fly.style.height = '20px';
                fly.style.opacity = '0';
            }, 50);
            setTimeout(() => fly.remove(), 1500);
        }
    } catch(e) { console.error(e); }
}



async function pegarDropChao(dropId) {
    try {
        const res = await fetch('/api/pegar_drop/' + dropId, {method: 'POST'});
        const data = await res.json();
        if (!data.ok) {
            console.log('Drop falhou:', data.msg);
            return;
        }
        // Animação: elemento voa até a hotbar
        const el = document.querySelector('.drop-chao[data-drop-id="' + dropId + '"]');
        if (el) {
            const rect = el.getBoundingClientRect();
            const fly = document.createElement('div');
            fly.style.cssText = 'position:fixed;width:36px;height:36px;background:url(' + el.style.backgroundImage.slice(5, -2) + ') center/contain no-repeat;left:' + rect.left + 'px;top:' + rect.top + 'px;z-index:9999;pointer-events:none;transition:all 1s ease-out;filter:drop-shadow(0 0 6px gold)';
            document.body.appendChild(fly);
            setTimeout(() => {
                fly.style.left = (window.innerWidth - 80) + 'px';
                fly.style.top = '80px';
                fly.style.opacity = '0';
                fly.style.transform = 'scale(0.3)';
            }, 30);
            setTimeout(() => fly.remove(), 1100);
        }
        // Remove localmente (será atualizado no próximo polling)
        window._dropsChao = window._dropsChao.filter(d => d.id !== dropId);
        // Recarrega o inventário
        setTimeout(() => { if (typeof carregarEstado === 'function') carregarEstado(); }, 1100);
    } catch(e) { console.error(e); }
}

async function carregarDropsChao() {
    try {
        const r = await fetch('/api/drops_chao');
        window._dropsChao = await r.json();
    } catch(e) { window._dropsChao = []; }
}

async function carregarObjetosMapa() {
    try {
        const res = await fetch('/api/objetos');
        window._objetosMapa = await res.json();
        const r2 = await fetch('/api/drops_chao');
