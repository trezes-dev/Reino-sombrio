  if (aba === "compra") {
    btnC.style.background = "#c9a227"; btnC.style.color = "#0a0a1a"; btnC.style.border = "none";
    btnV.style.background = "#3a2a10"; btnV.style.color = "#aaa"; btnV.style.border = "1px solid #c9a227";
  } else {
    btnV.style.background = "#c9a227"; btnV.style.color = "#0a0a1a"; btnV.style.border = "none";
    btnC.style.background = "#3a2a10"; btnC.style.color = "#aaa"; btnC.style.border = "1px solid #c9a227";
  }
  limparDetalheLoja();
  await carregarLoja();
}

async function carregarLoja() {
  const ouro = J ? J.ouro : 0;
  document.getElementById("loja-ouro").textContent = "💰 Seu ouro: " + ouro;
  const grade = document.getElementById("loja-grade");
  grade.innerHTML = "";
  let itens = [];
  if (lojaAba === "compra") {
    const r = await fetch("/api/loja/itens?npc_id=" + lojaNpcId);
    lojaItensCompra = await r.json();
    itens = lojaItensCompra;
  } else {
    lojaItensVenda = (J && J.inv) || [];
    itens = lojaItensVenda;
  }
  if (!itens.length) {
    grade.innerHTML = '<div style="grid-column:1/-1;padding:20px;text-align:center;color:#666;font-size:11px">' + (lojaAba === "compra" ? "Loja vazia" : "Inventario vazio") + '</div>';
    return;
  }
  itens.forEach((it, idx) => {
    const slot = document.createElement("div");
    slot.style.cssText = "aspect-ratio:1;background:#1a1005;border:2px solid #3a2a10;border-radius:5px;display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative";
    let nome, icone, preco;
    if (lojaAba === "compra") {
      nome = it.nome; preco = it.preco;
      icone = iconeDe(it.nome, 30);
    } else {
      nome = it[0]; preco = "?";
      icone = iconeDe(it[0], 30);
    }
    slot.innerHTML = icone + '<span style="position:absolute;bottom:1px;right:3px;font-size:9px;color:#ffd700;font-weight:bold">' + (lojaAba === "venda" && it[3] ? "x" + it[3] : "") + '</span>';
    slot.onclick = () => selecionarItemLoja(idx);
    slot.dataset.idx = idx;
    grade.appendChild(slot);
  });
}

function selecionarItemLoja(idx) {
  document.querySelectorAll("#loja-grade > div").forEach(s => s.style.borderColor = "#3a2a10");
  const slot = document.querySelector('#loja-grade > div[data-idx="' + idx + '"]');
  if (slot) slot.style.borderColor = "#ffd700";
  let nome, tipo, bonus, preco, qtdDisp;
  if (lojaAba === "compra") {
    const it = lojaItensCompra[idx];
    nome = it.nome; tipo = it.tipo; bonus = it.bonus; preco = it.preco;
    lojaItemSel = { tipo: "compra", id: it.id, nome: nome, preco: preco };
  } else {
    const it = lojaItensVenda[idx];
    nome = it[0]; tipo = it[1]; bonus = it[2]; qtdDisp = it[3];
    const invId = it[5];
    const preco_loja = lojaItensCompra.find(x => x.nome === nome);
    preco = preco_loja ? Math.max(1, Math.floor(preco_loja.preco / 2)) : (tipo === "arma" ? 10 : tipo === "escudo" ? 7 : 5);
    lojaItemSel = { tipo: "venda", id: invId, nome: nome, preco: preco, qtdDisp: qtdDisp };
  }
  document.getElementById("loja-det-icone").innerHTML = iconeDe(nome, 44);
  document.getElementById("loja-det-nome").textContent = nome;
  document.getElementById("loja-det-info").textContent = tipo + " +" + (bonus || 0);
  document.getElementById("loja-det-preco").textContent = preco + " ouro";
  document.getElementById("loja-qtd").value = 1;
  atualizarBotaoLoja();
}

function limparDetalheLoja() {
  document.getElementById("loja-det-icone").innerHTML = "—";
  document.getElementById("loja-det-nome").textContent = "Selecione um item";
  document.getElementById("loja-det-info").textContent = "";
  document.getElementById("loja-det-preco").textContent = "";
  document.getElementById("loja-qtd").value = 1;
  const btn = document.getElementById("loja-btn-acao");
  btn.textContent = lojaAba === "compra" ? "COMPRAR" : "VENDER";
  btn.disabled = true;
  btn.style.background = "#333";
  btn.style.color = "#666";
  btn.style.cursor = "not-allowed";
}

function atualizarBotaoLoja() {
  const btn = document.getElementById("loja-btn-acao");
  if (!lojaItemSel) { btn.disabled = true; return; }
  const qtd = parseInt(document.getElementById("loja-qtd").value) || 1;
  const total = lojaItemSel.preco * qtd;
  const temOuro = (J.ouro || 0) >= total;
  if (lojaAba === "compra") {
    btn.textContent = "COMPRAR (" + total + ")";
    btn.disabled = false;
    if (temOuro) {
      btn.style.background = "#4a7c2a"; btn.style.color = "#fff";
    } else {
      btn.style.background = "#c47a1a"; btn.style.color = "#fff";
    }
    btn.style.cursor = "pointer";
  } else {
    btn.textContent = "VENDER (" + total + " ouro)";
    if (qtd > (lojaItemSel.qtdDisp || 0)) {
      btn.disabled = true; btn.style.background = "#333"; btn.style.color = "#666"; btn.style.cursor = "not-allowed";
    } else {
      btn.disabled = false; btn.style.background = "#c9a227"; btn.style.color = "#0a0a1a"; btn.style.cursor = "pointer";
    }
  }
}

function mudarQtdLoja(delta) {
  const inp = document.getElementById("loja-qtd");
  let v = (parseInt(inp.value) || 1) + delta;
  if (v < 1) v = 1;
  inp.value = v;
  atualizarBotaoLoja();
}

function setQtdLoja(qtd) {
  document.getElementById("loja-qtd").value = qtd;
  atualizarBotaoLoja();
}

document.addEventListener("input", (e) => {
  if (e.target && e.target.id === "loja-qtd") atualizarBotaoLoja();
});

async function confirmarLoja() {
  if (!lojaItemSel) return;
  const qtd = parseInt(document.getElementById("loja-qtd").value) || 1;
  const msg = document.getElementById("loja-msg");
  if (lojaAba === "compra") {
    const r = await fetch("/api/comprar/" + lojaItemSel.id, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({qtd: qtd})
    });
    const j = await r.json();
    msg.textContent = j.msg;
    msg.style.display = "block";
    msg.style.color = j.msg && j.msg.indexOf("insuficiente") !== -1 ? "#ff5566" : "#4aff66";
    if (j.estado) render(j.estado);
  } else {
    const r = await fetch("/api/vender/" + lojaItemSel.id, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({qtd: qtd})
    });
    const j = await r.json();
    msg.textContent = j.msg;
    msg.style.display = "block";
    msg.style.color = "#4aff66";
    if (j.estado) render(j.estado);
  }
  lojaItemSel = null;
  limparDetalheLoja();
  await carregarLoja();
}

setTimeout(carregarObjetosMapa, 1000);
</script>
