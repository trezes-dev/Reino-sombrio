function fecharConfig() { fecharModal("modal-config"); }
function sairJogo() { if (confirm("Sair da conta?")) window.location.href = "/logout"; }

// ============ DEV ============
function abrirDev() {
  if (!J) return;
  const permitidos = ["ajudante","mod","admin","dev"];
  if (!permitidos.includes(J.cargo)) return;
  document.querySelectorAll("#modal-dev [data-perm]").forEach(el => {
    const perms = el.getAttribute("data-perm").split(",");
    el.style.display = perms.includes(J.cargo) ? "" : "none";
  });
  abrirModal("modal-dev");
}
function fecharDev() { fecharModal("modal-dev"); }
async function devAcao(acao, valor, extra) {
  const payload = { acao, valor };
  if (extra) Object.assign(payload, extra);
  const r = await fetch("/api/dev/acao", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify(payload) });
  const j = await r.json();
  const msg = document.getElementById("dev-msg");
  if (msg) {
    const texto = j.msg || j.erro || "feito";
    msg.textContent = texto;
    msg.style.display = texto ? "block" : "none";
  }
  const s = await fetch("/api/estado"); render(await s.json());
}

// ============ POLLING ============
setInterval(async () => { if (document.hidden) return; try { const r = await fetch("/api/estado"); if (r.ok) render(await r.json()); } catch(e) {} }, 1000);
setInterval(() => { if (document.hidden) return; carregarChat(false); }, 3000);
window.addEventListener("resize", () => { if (J) render(J); });
window.addEventListener("orientationchange", () => setTimeout(() => { if (J) render(J); }, 400));

// ============ INIT ============
carregar();
setInterval(carregarDropsChao, 1000);
