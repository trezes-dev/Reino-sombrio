/* === DROPS NO CHÃO === */
.drop-chao{
    position:absolute;
    width:40px;height:40px;
    background-size:contain;
    background-repeat:no-repeat;
    background-position:center;
    z-index:4;
    pointer-events:none;
    animation:dropFloat 1.5s ease-in-out infinite;
    filter:drop-shadow(0 0 4px gold);
}
@keyframes dropFloat{
    0%, 100%{transform:translateY(0)}
    50%{transform:translateY(-4px)}
}
.drop-fly{
    position:fixed;
    width:40px;height:40px;
    background-size:contain;
    background-repeat:no-repeat;
    z-index:9999;
    pointer-events:none;
    transition:all 1.2s ease-out;
}


/* === SLIMES COLORIDOS (CSS ÚNICO) === */
.sprite.monstro-slime-verde{background-image:url('/static/sprites/monstros/slime_verde.png?v=99');background-size:384px 256px;background-position:0 0;background-repeat:no-repeat;animation:monstroIdle 1s steps(6) infinite}
.sprite.monstro-slime-azul{background-image:url('/static/sprites/monstros/slime_azul.png?v=99');background-size:384px 256px;background-position:0 0;background-repeat:no-repeat;animation:monstroIdle 1s steps(6) infinite}
.sprite.monstro-slime-vermelho{background-image:url('/static/sprites/monstros/slime_vermelho.png?v=99');background-size:384px 256px;background-position:0 0;background-repeat:no-repeat;animation:monstroIdle 1s steps(6) infinite}
.sprite.monstro-slime-dourado{background-image:url('/static/sprites/monstros/slime_dourado.png?v=99');background-size:384px 256px;background-position:0 0;background-repeat:no-repeat;animation:monstroIdle 1s steps(6) infinite}
@keyframes monstroIdle{from{background-position:0 0}to{background-position:-384px 0}}

