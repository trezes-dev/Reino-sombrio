let ultimoGuildMsg = 0;
async function carregarGuildChat() {
  const box = document.getElementById("guild-chat-msgs");
  if (!box) return;
  const r = await fetch("/api/chat/guild?desde=" + ultimoGuildMsg);
  const novas = await r.json();
  if (!novas.length) return;
  novas.forEach(m => {
    ultimoGuildMsg = m.id;
    const hora = new Date(m.ts * 1000).toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
    const div = document.createElement("div");
    div.innerHTML = '<span style="color:#555">' + hora + '</span> <span style="color:' + m.cor + ';font-weight:bold">' + (m.badge||"") + ' ' + m.nome + '</span>: ' + m.texto.replace(/</g,"&lt;");
    box.appendChild(div);
  });
  box.scrollTop = box.scrollHeight;
}
async function enviarGuildChat() {
  const inp = document.getElementById("guild-chat-input");
  const texto = inp.value.trim(); if (!texto) return; inp.value = "";
  await fetch("/api/chat/guild/enviar", {method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({texto})});
  await carregarGuildChat();
}
async function acaoGuild(acao, valor) {
  if (valor === null || valor === undefined) return;
  const r = await fetch("/api/guild/acao", {method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({acao, nome: valor})});
  const j = await r.json();
  const m = document.getElementById("guild-msg");
  if (m) { m.textContent = j.msg; m.style.display = "block"; }
  setTimeout(atualizarGuild, 800);
}
