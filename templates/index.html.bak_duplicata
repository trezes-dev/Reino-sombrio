.tile.obj-barril{background-image:url('/static/sprites/terreno/lobby/usaveis/Bush_simple1_1.png');background-size:contain;background-repeat:no-repeat;background-position:center bottom}
.tile.obj-flor_azul{background-image:url('/static/sprites/terreno/lobby/usaveis/Bush_blue_flowers1.png');background-size:contain;background-repeat:no-repeat;background-position:center bottom}
