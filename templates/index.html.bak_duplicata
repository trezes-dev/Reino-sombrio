(function preloadSprites() {
  const dirs = ["cima","esq","baixo","dir"];
  window._spriteCache = {};
  const promises = [];
  dirs.forEach(d => {
    for (let i = 0; i < 9; i++) {
      const url = "/static/sprites/jogador/walk-" + d + "-" + i + ".png";
      const img = new Image();
      img.src = url;
      window._spriteCache[url] = img;
      promises.push(img.decode ? img.decode().catch(()=>{}) : Promise.resolve());
    }
    for (let i = 0; i < 2; i++) {
      const url = "/static/sprites/jogador/idle-" + d + "-" + i + ".png";
      const img = new Image();
      img.src = url;
      window._spriteCache[url] = img;
      promises.push(img.decode ? img.decode().catch(()=>{}) : Promise.resolve());
    }
    for (let i = 0; i < 6; i++) {
      const url = "/static/sprites/jogador/slash-" + d + "-" + i + ".png";
      const img = new Image();
      img.src = url;
      window._spriteCache[url] = img;
      promises.push(img.decode ? img.decode().catch(()=>{}) : Promise.resolve());
