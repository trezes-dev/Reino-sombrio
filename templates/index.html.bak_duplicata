function danoFlut(mx, my, txt, tipo) {
  if (!J) return;
  const mapa = document.getElementById("mapa");
  const el = document.createElement("div");
  el.className = "dano-flut" + (tipo ? " " + tipo : "");
  el.textContent = txt;
