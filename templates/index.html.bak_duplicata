function render(j) {
  if (!j) return;
  J = j;
  const cor = j.cargo_cor || j.cor || "#4af";

  // HUD TOPO
  document.getElementById("hud-nome").innerHTML = '<span style="color:' + cor + '">' + (j.cargo_badge||"") + ' ' + j.nome + '</span>';
  document.getElementById("hud-nivel").textContent = "Nv " + j.nivel;
  document.getElementById("hud-ouro").textContent = "💰 " + j.ouro;

  // HUD VIDA
  const hpPct = Math.max(0, Math.min(100, (j.hp / j.hp_max) * 100));
  document.getElementById("hp-fill").style.width = hpPct + "%";
  document.getElementById("hp-txt").textContent = j.hp + "/" + j.hp_max;
  const xpProx = Math.floor(100 * Math.pow(j.nivel, 1.5));
  document.getElementById("xp-fill").style.width = Math.min(100, (j.xp/xpProx)*100) + "%";
  document.getElementById("xp-txt").textContent = j.xp + "/" + xpProx;

  // MAPA
  const mapa = document.getElementById("mapa");
  mapa.style.gridTemplateColumns = "repeat(" + VIEW + ", " + TILE_PX + "px)";
  mapa.style.gridTemplateRows = "repeat(" + VIEW + ", " + TILE_PX + "px)";
  const centroX = window.innerWidth / 2;
  const centroY = window.innerHeight / 2;
  const offsetX = Math.round(centroX - (METADE * TILE_PX + TILE_PX / 2));
  const offsetY = Math.round(centroY - (METADE * TILE_PX + TILE_PX / 2));
  mapa.style.transform = "translate(" + offsetX + "px, " + offsetY + "px)";
  mapa.innerHTML = "";

  const monsMap = {};
  (j.monstros || []).forEach(m => { monsMap[m[2]+","+m[3]] = m; });
  const npcsSet = {};
  (j.npcs || []).forEach(n => { npcsSet[n[2]+","+n[3]] = n; });
  const outrosMap = {};
  (j.outros || []).forEach(o => { outrosMap[o.x+","+o.y] = o; });

  for (let vy = 0; vy < VIEW; vy++) {
    for (let vx = 0; vx < VIEW; vx++) {
      const mx = j.x - METADE + vx;
      const my = j.y - METADE + vy;
      const tipo = (j.viewport[vy] && j.viewport[vy][vx]) || "grama";
      const d = document.createElement("div");
      d.className = "tile " + tipo;

      if (mx === j.x && my === j.y) {
        const sp = document.createElement("div");
        sp.className = "sprite player";
        sp.id = "sprite-player";
        sp.style.backgroundImage = "url('/static/sprites/jogador/idle-" + (_ultimoDir || "baixo") + "-0.png')";
        const hp = document.createElement("div");
        hp.className = "hp-ent player-hp";
        hp.innerHTML = '<div class="fill" style="width:' + hpPct + '%"></div>';
        sp.appendChild(hp);
        const nom = document.createElement("div");
        nom.className = "nome-ent";
        nom.style.color = cor;
        nom.textContent = (j.cargo_badge ? j.cargo_badge + " " : "") + j.nome;
        sp.appendChild(nom);
        d.appendChild(sp);
      } else if (monsMap[mx+","+my]) {
        const m = monsMap[mx+","+my];
        const sp = document.createElement("div");
        sp.className = "sprite " + spriteMonstro(m[1]);
        const hp = document.createElement("div");
        hp.className = "hp-ent";
        const mhpPct = Math.max(0, Math.min(100, (m[4] / (m[4] + 20)) * 100));
        hp.innerHTML = '<div class="fill" style="width:' + mhpPct + '%"></div>';
        sp.appendChild(hp);
        const nom = document.createElement("div");
        nom.className = "nome-ent";
        nom.style.color = "#ffcccc";
        nom.textContent = m[1] + " (" + m[4] + ")";
        sp.appendChild(nom);
        d.appendChild(sp);
      } else if (npcsSet[mx+","+my]) {
        const n = npcsSet[mx+","+my];
        const sp = document.createElement("div");
        const tipoNPC = (n[4] || "loja").toLowerCase();
        sp.className = "sprite npc-" + tipoNPC;
        const nom = document.createElement("div");
        nom.className = "nome-ent";
        nom.style.color = "#ffee88";
        nom.textContent = n[1];
        sp.appendChild(nom);
        d.appendChild(sp);
      } else if (outrosMap[mx+","+my]) {
        const o = outrosMap[mx+","+my];
        const sp = document.createElement("div");
        sp.className = "sprite outro";
        sp.style.background = o.cor;
        const nom = document.createElement("div");
        nom.className = "nome-ent";
        nom.style.color = o.cor;
        nom.textContent = (o.badge ? o.badge + " " : "") + o.nome;
        sp.appendChild(nom);
        d.appendChild(sp);
      }
      mapa.appendChild(d);
    }
  }

  // === OBJETOS DO MAPA (fogueira, flores, barris, árvores) ===
  if (window._objetosMapa && window._objetosMapa.length > 0) {
    window._objetosMapa.forEach(obj => {
      const dx = obj.x - j.x;
      const dy = obj.y - j.y;
      if (Math.abs(dx) > METADE || Math.abs(dy) > METADE) return;
      
      const obj_div = document.createElement("div");
      obj_div.className = "tile obj-" + obj.subtipo;
      obj_div.style.position = "absolute";
      obj_div.style.left = ((obj.x - (j.x - METADE)) * TILE_PX) + "px";
      obj_div.style.top = ((obj.y - (j.y - METADE)) * TILE_PX) + "px";
      obj_div.style.width = TILE_PX + "px";
      obj_div.style.height = TILE_PX + "px";
      obj_div.style.backgroundSize = "contain";
      obj_div.style.backgroundRepeat = "no-repeat";
      obj_div.style.backgroundPosition = "center";
      obj_div.style.pointerEvents = "none";
      obj_div.style.zIndex = "5";
      mapa.appendChild(obj_div);
    });
  }

  // === DROPS NO CHÃO ===
  if (window._dropsChao && window._dropsChao.length > 0) {
    window._dropsChao.forEach(drop => {
      const dx = drop.x - j.x;
      const dy = drop.y - j.y;
      if (Math.abs(dx) > METADE || Math.abs(dy) > METADE) return;
      const drop_div = document.createElement("div");
      drop_div.className = "drop-chao";
      drop_div.style.left = ((drop.x - (j.x - METADE)) * TILE_PX + 2) + "px";
      drop_div.style.top = ((drop.y - (j.y - METADE)) * TILE_PX + 2) + "px";
      drop_div.style.backgroundImage = "url('" + spriteDropItem(drop.item) + "')";
      drop_div.dataset.dropId = drop.id;
      drop_div.onclick = (e) => { e.stopPropagation(); pegarDropChao(drop.id); };
      mapa.appendChild(drop_div);
    });
  }

  // MINI MAPA - Imagem gerada pelo servidor
  if (window._mmContador === undefined) window._mmContador = 0;
  window._mmContador++;
  if (window._mmContador % 10 === 0) {
    const img = document.getElementById("minimapa-img");
    if (img) img.src = "/minimapa.png?t=" + Date.now();
  }

  // HOTBAR
  const hb = document.getElementById("hotbar");
  hb.innerHTML = "";
  const itens = j.inv || [];
  const invPorId = {};
  itens.forEach(x => { invPorId[x[4]] = { nome: x[0], tipo: x[1], bonus: x[2], qtd: x[3], id: x[4] }; });
  let hbIds = j.hotbar || [];
  while (hbIds.length < 8) hbIds.push(0);
  for (let i = 0; i < 8; i++) {
    const slot = document.createElement("div");
    const itemId = hbIds[i] || 0;
    if (itemId && invPorId[itemId]) {
      const it = invPorId[itemId];
      const semQtd = it.qtd <= 0;
      slot.className = "slot" + (semQtd ? " vazio" : "");
      slot.innerHTML = iconeDe(it.nome, 36) + '<span class="qtd">' + it.qtd + '</span>';
      slot.title = it.nome;
    } else {
      slot.className = "slot";
      slot.style.opacity = "0.3";
    }
    slot.onclick = () => abrirPicker(i);
    hb.appendChild(slot);
  }
}

