        console.log("Objetos carregados:", window._objetosMapa.length);
    } catch (e) {
        console.error("Erro objetos:", e);
    }
}


function spriteMonstro(nome) {
    nome = (nome || '').toLowerCase();
    if (nome.includes('azul'))     return 'monstro-slime-azul';
    if (nome.includes('vermelho')) return 'monstro-slime-vermelho';
    if (nome.includes('verde'))    return 'monstro-slime-verde';
    if (nome.includes('slime'))    return 'monstro-slime-verde';
    if (nome.includes('goblin'))   return 'monstro-goblin';
    if (nome.includes('esqueleto'))return 'monstro-esqueleto';
    return 'monstro-slime-verde';
}


function spriteDropItem(nome) {
    nome = (nome || '').toLowerCase();
    if (nome.includes('cura') || nome.includes('vermelha')) return '/static/sprites/itens/pocao-vermelha.png';
    if (nome.includes('mana') || nome.includes('azul')) return '/static/sprites/itens/pocao-azul.png';
    if (nome.includes('veneno') || nome.includes('verde')) return '/static/sprites/itens/pocao-verde.png';
    if (nome.includes('adaga') && nome.includes('magic')) return '/static/sprites/itens/adaga-magica.png';
    if (nome.includes('adaga')) return '/static/sprites/itens/adaga.png';
    if (nome.includes('espada') && nome.includes('gelo')) return '/static/sprites/itens/espada-gelo.png';
    if (nome.includes('espada') && nome.includes('fogo')) return '/static/sprites/itens/espada-fogo.png';
    if (nome.includes('espada') && nome.includes('sombria')) return '/static/sprites/itens/espada-sombria.png';
    if (nome.includes('espada') && nome.includes('veneno')) return '/static/sprites/itens/espada-veneno.png';
