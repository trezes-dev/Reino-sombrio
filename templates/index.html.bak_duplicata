/* ==== ENTIDADES ==== */
.sprite{position:absolute;inset:0;background-size:cover;background-position:center;image-rendering:pixelated;z-index:3;transition:transform 0.4s ease-out}
.sprite.player{background-image:url('/static/sprites/jogador/idle-baixo-0.png');z-index:5}
.sprite.monstro-goblin{background-image:url('/static/sprites/monstros/goblin.png?v=2');background-size:384px 256px;background-position:0 0;animation:monstroIdle 1s steps(6) infinite}
.sprite.monstro-esqueleto{background-image:url('/static/sprites/monstros/esqueleto.png?v=2');background-size:384px 256px;background-position:0 0;animation:monstroIdle 1s steps(6) infinite}
.sprite/* .monstro-slime removido */
to{background-position:-384px 0}}
.sprite.npc-loja{background-image:url('/static/sprites/npc-mercador.png')}
.sprite.npc-ferreiro{background-image:url('/static/sprites/npc-ferreiro.png')}
.sprite.npc-alquimista{background-image:url('/static/sprites/npc-alquimista.png')}
.sprite.npc{background-image:url('/static/sprites/npc-mercador.png')}
.sprite.outro{border-radius:50%;box-shadow:0 0 8px #fff}
.nome-ent{position:absolute;top:-16px;left:50%;transform:translateX(-50%);font-size:10px;white-space:nowrap;text-shadow:2px 2px 0 #000,-1px -1px 0 #000;z-index:10;pointer-events:none;font-weight:bold}
.hp-ent{position:absolute;top:-6px;left:8px;right:8px;height:4px;background:#000;border-radius:2px;z-index:10;overflow:hidden}
.hp-ent .fill{height:100%;background:#c33;transition:width 0.2s}
.hp-ent.player-hp .fill{background:#4af}

/* ==== DANO FLUTUANTE ==== */
.dano-flut{position:absolute;font-size:14px;font-weight:bold;color:#ff4466;text-shadow:2px 2px 0 #000,-1px -1px 0 #000;animation:sobe 1s ease-out forwards;pointer-events:none;z-index:20}
.dano-flut.cur{color:#4f4}
.dano-flut.xp{color:#ffd700}
@keyframes sobe{0%{transform:translateY(0);opacity:1}100%{transform:translateY(-40px);opacity:0}}

/* ==== HUD TOPO ==== */
#hud-topo{position:absolute;top:0;left:0;right:0;height:42px;display:flex;align-items:center;justify-content:space-between;padding:4px 8px;z-index:30;pointer-events:none;background:linear-gradient(to bottom,rgba(0,0,0,0.7),transparent)}
#hud-topo .info{display:flex;align-items:center;gap:6px;background:rgba(20,15,30,0.85);border:2px solid #5a4a3a;border-radius:8px;padding:3px 10px;font-size:11px}
#hud-nome{font-weight:bold}
#hud-nivel{color:#ffd700;font-weight:bold}
#hud-ouro{color:#ffd700}
#hud-topo .botoes{display:flex;gap:5px;pointer-events:auto}
.btn-hud{width:36px;height:36px;border-radius:50%;background:rgba(20,15,30,0.9);border:2px solid #8a7a5a;color:#fff;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
.btn-hud:active{transform:scale(0.9)}

/* ==== HUD VIDA ==== */
#hud-vida{position:absolute;bottom:68px;left:50%;transform:translateX(-50%);background:rgba(20,15,30,0.85);border:2px solid #8a7a5a;border-radius:6px;padding:4px 8px;z-index:30;width:240px}
#hud-vida .top{display:flex;align-items:center;gap:6px;font-size:9px;margin-bottom:2px}
#hud-vida .lbl{color:#aaa}
#hud-vida .val{font-weight:bold;color:#fff;font-size:10px}
.barra{width:100%;height:10px;background:#0a0505;border:1px solid #444;border-radius:2px;overflow:hidden;position:relative}
.barra .fill{height:100%;transition:width 0.3s}
#hp-fill{background:linear-gradient(180deg,#ff4444,#a01010)}
.barra-xp{width:100%;height:4px;background:#000;border:1px solid #444;border-radius:2px;overflow:hidden;margin-top:2px}
.barra-xp .fill{height:100%;background:linear-gradient(90deg,#4af6ff,#a06bff);transition:width 0.3s}

/* ==== MINI MAPA (CANVAS) ==== */

/* ==== HOTBAR ==== */
#hotbar{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);display:flex;gap:4px;z-index:30;background:rgba(20,15,30,0.85);border:2px solid #8a7a5a;border-radius:8px;padding:4px}
.slot{width:44px;height:44px;background:rgba(40,30,20,0.9);border:2px solid #6a5a3a;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:22px;position:relative;cursor:pointer}
.slot .qtd{position:absolute;bottom:1px;right:3px;font-size:10px;font-weight:bold;color:#fff;text-shadow:1px 1px 0 #000}
.slot.vazio{opacity:0.4;filter:grayscale(1)}

/* ==== JOYSTICK ==== */
#joystick{position:fixed;width:130px;height:130px;z-index:100;touch-action:none;display:none;pointer-events:none;transform:translate(-50%,-50%)}
#joy-base{position:absolute;inset:0;background-image:url('/static/ui/joystick_circle_pad_a.png');background-size:cover;opacity:0.65}
#joy-thumb{position:absolute;top:50%;left:50%;width:64px;height:64px;margin:-32px 0 0 -32px;background-image:url('/static/ui/joystick_circle_nub_a.png');background-size:cover;opacity:0.9}
#zona-joystick{position:fixed;left:0;top:0;width:50%;height:100%;z-index:24;touch-action:none}

/* ==== BOTÕES DE AÇÃO ==== */










/* ==== LOG ==== */
#log{position:absolute;top:50px;left:8px;background:rgba(0,0,0,0.75);border-left:3px solid #4af6ff;padding:4px 10px;border-radius:4px;font-size:11px;color:#8fff8f;max-width:280px;z-index:25;opacity:0;transition:opacity 0.3s}
#log.vis{opacity:1}

/* ==== MODAIS ==== */
.modal{position:fixed;inset:0;background:rgba(0,0,0,0.94);z-index:100;display:none;flex-direction:column;padding:14px;overflow-y:auto;font-family:monospace}
.modal.aberto{display:flex}
.modal-topo{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.modal-topo h2{margin:0;font-size:14px;color:#4af6ff}
.modal-topo button{padding:6px 12px;background:#222;color:#ff5566;border:1px solid #ff5566;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px}
.modal-corpo{max-width:500px;width:100%;margin:auto}





