    h += '<button onclick="acaoGuildConvidar()" style="padding:6px;background:#333;color:#fff;border:1px solid #4af6ff;border-radius:4px;font-family:inherit;font-size:11px;cursor:pointer">+ Convidar</button>';
    h += '<button onclick="acaoGuild(\'renomear\', prompt(\'Novo nome (5M):\'))" style="padding:6px;background:#333;color:#fff;border:1px solid #ffd700;border-radius:4px;font-family:inherit;font-size:11px;cursor:pointer">Renomear</button>';
  }
  h += '<button onclick="acaoGuild(\'sair\')" style="grid-column:1/-1;padding:6px;background:#3a0a0a;color:#ff8899;border:1px solid #ff5566;border-radius:4px;font-family:inherit;font-size:11px;cursor:pointer">Sair</button></div>';
  h += '<div id="guild-msg" style="display:none;background:#0a0a14;border:1px solid #c9a227;border-radius:4px;padding:6px;font-size:11px;color:#c9a227;margin-top:8px"></div>';
  h += '<div style="font-size:11px;color:#888;margin:12px 0 4px">💬 CHAT DA GUILDA</div>';
  h += '<div id="guild-chat-msgs" style="background:#0a0a14;border:1px solid #2a2a4a;border-radius:4px;padding:8px;height:140px;overflow-y:auto;font-size:11px;line-height:1.5"></div>';
