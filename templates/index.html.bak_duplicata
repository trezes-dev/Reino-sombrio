    </div>
    <div class="botoes">
      <button class="btn-hud" onclick="abrirPerfil()" title="Perfil">👤</button>
      <button class="btn-hud" onclick="abrirInv()" title="Inventário">🎒</button>
      <button class="btn-hud" onclick="abrirChat()" title="Chat">💬</button>
      <button class="btn-hud" onclick="abrirConfig()" title="Config">⚙️</button>
      <button class="btn-hud" onclick="abrirMapaGrande()" title="Mapa" style="background:radial-gradient(circle at 35% 30%,#5a8ab0,#1a3a5a);border-color:#8ac0e0">🌍</button>
    </div>
  </div>

  <div id="minimapa-box" style="display:none;position:absolute;top:60px;right:10px;z-index:1000;background:rgba(0,0,0,0.9);padding:5px;border-radius:5px;border:1px solid #444;"><img id="minimapa-img" src="/minimapa.png" style="width:200px;height:200px;image-rendering:pixelated;display:block;"><div style="color:#aaa;font-size:10px;text-align:center;margin-top:3px;">Toque para fechar</div></div>

  <div id="log"></div>

  <div id="hud-vida">
    <div class="top">
      <span class="lbl">HP</span>
      <span class="val" id="hp-txt">100/100</span>
      <span class="lbl" style="margin-left:auto">XP</span>
      <span class="val" id="xp-txt">0/100</span>
    </div>
    <div class="barra"><div class="fill" id="hp-fill" style="width:100%"></div></div>
    <div class="barra-xp"><div class="fill" id="xp-fill" style="width:0%"></div></div>
  </div>

  <div id="hotbar"></div>

  <div id="zona-joystick"></div>
  <div id="joystick">
    <div id="joy-base"></div>
    <div id="joy-thumb"></div>
  </div>

  <button id="btn-ataque" class="btn-acao" onclick="atacar()"><img src="/static/sprites/itens/espada-aco.png" style="width:75%;height:75%;image-rendering:pixelated;pointer-events:none"></button>
  <button id="btn-ferramenta" class="btn-acao" onclick="usarFerramenta()"><img src="/static/sprites/itens/pocao-vermelha.png" style="width:75%;height:75%;image-rendering:pixelated;pointer-events:none"></button>
  <button id="btn-acao" class="btn-acao" onclick="acaoInteragir()">✋</button>
</div>

<!-- MODAL CHAT -->
<div id="modal-chat" class="modal">
  <div class="modal-topo">
    <h2>💬 CHAT GLOBAL</h2>
    <button onclick="fecharChat()">Fechar</button>
  </div>
  <div id="chat-msgs" style="flex:1;overflow-y:auto;background:#0a0a14;border:1px solid #2a2a3a;border-radius:6px;padding:8px;font-size:12px;line-height:1.5"></div>
  <div style="display:flex;gap:6px;margin-top:8px">
    <input id="chat-input" placeholder="msg ou /ajuda" maxlength="200" onkeydown="if(event.key==='Enter')enviarChat()" style="flex:1;padding:10px;background:#05070f;color:#4af6ff;border:2px solid #2a3050;font-family:inherit;font-size:12px;border-radius:6px;outline:none">
    <button onclick="enviarChat()" style="padding:10px 16px;background:#4af6ff;color:#0a0a1a;border:none;border-radius:6px;font-family:inherit;font-size:12px;cursor:pointer;font-weight:bold">Enviar</button>
  </div>
</div>

<!-- MODAL INVENTÁRIO -->
