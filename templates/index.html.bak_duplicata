async function abrirChatPriv(id, nome) {
  privAmigoAtual = id; ultimoPrivMsg = 0;
  document.getElementById("priv-titulo").textContent = "💬 Chat com " + nome;
  document.getElementById("priv-painel").style.display = "block";
  document.getElementById("priv-chat-msgs").innerHTML = "";
  await carregarPrivChat();
  if (!window._privInt) window._privInt = setInterval(() => { if (privAmigoAtual) carregarPrivChat(); }, 3000);
}
async function carregarPrivChat() {
  if (!privAmigoAtual) return;
  const box = document.getElementById("priv-chat-msgs"); if (!box) return;
  const r = await fetch("/api/chat/privado/" + privAmigoAtual + "?desde=" + ultimoPrivMsg);
  const novas = await r.json(); if (!novas.length) return;
  novas.forEach(m => { ultimoPrivMsg = m.id; const hora = new Date(m.ts*1000).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); const div = document.createElement("div"); div.innerHTML = '<span style="color:#555">' + hora + '</span> <span style="color:' + m.cor + ';font-weight:bold">' + (m.badge||"") + ' ' + m.nome + '</span>: ' + m.texto.replace(/</g,"&lt;"); box.appendChild(div); });
