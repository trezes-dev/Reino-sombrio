      '<button onclick="acaoGuild(\'criar\', document.getElementById(\'guild-criar-nome\').value)" style="width:100%;padding:10px;background:#c9a227;color:#0a0a1a;border:none;border-radius:4px;font-family:inherit;font-size:12px;font-weight:bold;cursor:pointer">Criar guilda</button>' +
