.tile.obj-flor_laranja{background-image:url('/static/sprites/terreno/lobby/usaveis/Bush_orange_flowers1.png');background-size:contain;background-repeat:no-repeat;background-position:center bottom}
.tile.obj-flor_vermelha{background-image:url('/static/sprites/terreno/lobby/usaveis/Bush_red_flowers1.png');background-size:contain;background-repeat:no-repeat;background-position:center bottom}


.obj-fogueira{background-image:url('/static/sprites/terreno/ruinas_temple/PNG/Fire_animation.png');background-size:contain;background-repeat:no-repeat;background-position:center}
