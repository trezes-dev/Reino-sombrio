    if (nome.includes('machado')) return '/static/sprites/itens/machado.png';
    if (nome.includes('lanca')) return '/static/sprites/itens/lanca.png';
    return '/static/sprites/itens/pocao-vermelha.png';
}


// === PREDIÇÃO DE MOVIMENTO (evita lag visual) ===
window._predMovendo = false;

function moverPreditivo(dir) {
    if (!J) return null;
    const passo = {cima:[0,-1],baixo:[0,1],esq:[-1,0],dir:[1,0]}[dir];
    if (!passo) return null;
    const novoX = Math.max(0, Math.min(W_MAP - 1, J.x + passo[0]));
    const novoY = Math.max(0, Math.min(H_MAP - 1, J.y + passo[1]));
    // Se não mudou (bateu no limite), não envia
    if (novoX === J.x && novoY === J.y) return null;
    J.x = novoX;
    J.y = novoY;
    _ultimoMover = Date.now();  // ← Marca que andou (ativa animação)
    // Renderiza IMEDIATAMENTE (sem esperar servidor)
    render(J);
    // Envia pro servidor em BACKGROUND (não bloqueia)
    // Throttle: só envia pro servidor a cada 80ms
    const agora = Date.now();
    if (!window._ultimoEnvioServidor || agora - window._ultimoEnvioServidor > 80) {
        window._ultimoEnvioServidor = agora;
        fetch('/api/mover/' + dir).then(r => r.json()).then(j => {
