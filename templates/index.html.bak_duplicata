  j.membros.forEach(m => {
    h += '<div style="display:flex;justify-content:space-between;padding:5px 8px;background:#0a0a14;border:1px solid #2a2a4a;border-radius:4px;margin-bottom:3px;font-size:11px"><span>' + (m.online?"🟢":"⚫") + ' ' + m.nome + '</span><span style="color:#888">' + m.cargo_guilda + '</span></div>';
