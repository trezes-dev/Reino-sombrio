// ============ JOYSTICK ============
(function() {
  const joy = document.getElementById("joystick");
  const zona = document.getElementById("zona-joystick");
  if (!joy || !zona) return;
  const thumb = document.getElementById("joy-thumb");
  let ativo = false, idToque = null, cx = 0, cy = 0;
  const raio = 55;
  let dirAtual = null;
  function resetar() {
    ativo = false; idToque = null;
    joy.style.display = "none";
    thumb.style.transform = "translate(0,0)";
    dirAtual = null;
  }
  function start(px, py) {
    cx = px; cy = py;
    joy.style.left = px + "px";
    joy.style.top = py + "px";
    joy.style.display = "block";
    ativo = true;
    movendo(px, py);
  }
  function movendo(px, py) {
    let dx = px - cx, dy = py - cy;
    const dist = Math.hypot(dx, dy);
    if (dist > raio) { dx = dx/dist*raio; dy = dy/dist*raio; }
    thumb.style.transform = "translate(" + dx + "px, " + dy + "px)";
    if (dist < 10) { dirAtual = null; return; }
    if (Math.abs(dx) > Math.abs(dy)) dirAtual = dx > 0 ? "dir" : "esq";
    else dirAtual = dy > 0 ? "baixo" : "cima";
  }
  zona.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    if (ativo) return;
    idToque = e.pointerId;
    zona.setPointerCapture(e.pointerId);
    start(e.clientX, e.clientY);
  });
  zona.addEventListener("pointermove", (e) => {
    if (!ativo || e.pointerId !== idToque) return;
    e.preventDefault();
    movendo(e.clientX, e.clientY);
  });
  zona.addEventListener("pointerup", (e) => { if (e.pointerId === idToque) resetar(); });
  zona.addEventListener("pointercancel", resetar);
  setInterval(() => { if (ativo && dirAtual) mover(dirAtual); }, 200);
})();
