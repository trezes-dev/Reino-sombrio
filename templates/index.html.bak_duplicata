  }
  h += '<div style="font-size:11px;color:#888;margin:10px 0 4px">AMIGOS (' + j.amigos.length + ')</div>';
  j.amigos.forEach(a => { h += '<div style="display:flex;justify-content:space-between;padding:6px 8px;background:#0a0a14;border:1px solid #2a2a4a;border-radius:4px;margin-bottom:4px;font-size:11px"><span style="cursor:pointer;flex:1;color:#4af6ff;text-decoration:underline" onclick="abrirChatPriv(' + a.id + ',\'' + a.nome + '\')">' + (a.online?"🟢":"⚫") + ' ' + a.nome + ' 💬</span><button onclick="removerAmigo(\'' + a.nome + '\')" style="padding:2px 8px;background:#3a0a0a;color:#ff8899;border:1px solid #ff5566;border-radius:3px;font-family:inherit;font-size:10px;cursor:pointer">✕</button></div>'; });
  h += '<div id="priv-painel" style="display:none;margin-top:12px"><div id="priv-titulo" style="font-size:11px;color:#4af6ff;margin-bottom:4px"></div><div id="priv-chat-msgs" style="background:#0a0a14;border:1px solid #4af6ff;border-radius:4px;padding:8px;height:140px;overflow-y:auto;font-size:11px"></div><div style="display:flex;gap:4px;margin-top:4px"><input id="priv-chat-input" placeholder="mensagem" maxlength="200" onkeydown="if(event.key===\'Enter\')enviarPrivChat()" style="flex:1;padding:8px;background:#0a0a1a;color:#fff;border:1px solid #555;border-radius:4px;font-family:inherit;font-size:11px"><button onclick="enviarPrivChat()" style="padding:8px 14px;background:#4af6ff;color:#0a0a1a;border:none;border-radius:4px;font-family:inherit;font-size:11px;font-weight:bold;cursor:pointer">Enviar</button></div></div>';
